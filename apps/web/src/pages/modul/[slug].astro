---
import "../../styles/global.css";
import ConsentManager from "../../components/ConsentManager";
import HppCalculator from "../../components/HppCalculator";
import KprCalculator from "../../components/KprCalculator";
import PayrollCalculator from "../../components/PayrollCalculator";
import PriceMarginCalculator from "../../components/PriceMarginCalculator";
import BreakEvenCalculator from "../../components/BreakEvenCalculator";
import { tools } from "../../data/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const isPayrollTool = tool.slug === "gaji-bersih";
const isKprTool = tool.slug === "simulasi-kpr";
const isHppTool = tool.slug === "kalkulator-hpp";
const isPriceMarginTool = tool.slug === "harga-jual-margin";
const isBepTool = tool.slug === "break-even-point";
const isCalculatorTool = isPayrollTool || isKprTool || isHppTool || isPriceMarginTool || isBepTool;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={isKprTool
      ? "Simulasi KPR anuitas, flat, efektif, bunga tetap dan mengambang, biaya, serta pembayaran pokok tambahan. Tarif bank tidak disediakan."
      : isPriceMarginTool
        ? "Hitung harga jual dengan membedakan margin dan markup, serta tampilkan laba setelah diskon dan biaya yang Anda pilih."
        : isBepTool
          ? "Hitung titik impas dari biaya tetap dan kontribusi per unit, termasuk BEP pecahan, unit utuh, nilai penjualan, serta laba/rugi di sekitar BEP."
        : isHppTool
          ? "Hitung HPP batch dan per unit dengan biaya langsung, susut bahan, overhead, dan alokasi penyusutan yang dinyatakan."
        : `${tool.name}: status, cakupan, dan informasi sebelum kalkulator ini tersedia.`} />
    <meta name="theme-color" content="#f4f6fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{tool.name} · JOBENAPP</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="JOBENAPP, halaman utama">
          <span class="brand-mark" aria-hidden="true">J</span>
          <span>JOBEN<span class="brand-accent">APP</span></span>
        </a>
        <nav class="main-nav" aria-label="Navigasi halaman">
          <a href="/">Beranda</a>
          <a href="/#modul">Semua modul</a>
        </nav>
        <a class="header-cta" href="/#modul">Katalog <span aria-hidden="true">↗</span></a>
      </header>
      <main class="module-page">
        <a class="access-back-link" href="/#modul">← Kembali ke semua modul</a>
        <section class:list={["module-detail-card", `tone-${tool.tone}`, isPayrollTool && "payroll-module-card", isKprTool && "kpr-module-card", isHppTool && "hpp-module-card", isPriceMarginTool && "price-margin-module-card", isBepTool && "bep-module-card"]}>
          <div class="module-detail-heading">
            <span class="tool-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={tool.icon} /></svg>
            </span>
            <span class="tool-category">{tool.category}</span>
            <span class="tool-status">
              {isPayrollTool
                ? "Engine tersedia · aturan belum ditinjau"
                : isKprTool
                  ? "Kalkulator tersedia · tanpa tarif bank"
                  : isHppTool
                    ? "Kalkulator tersedia · input pengguna"
                    : isPriceMarginTool
                      ? "Kalkulator tersedia · tarif input pengguna"
                      : isBepTool
                        ? "Kalkulator tersedia · review independen diperlukan"
                  : "Dalam persiapan"}
            </span>
          </div>
          <p class="section-kicker">FASE {tool.phase}</p>
          <h1>{tool.name}</h1>
          <p class="module-detail-description">
            {isPayrollTool
              ? "Rincian PPh 21 dan enam program BPJS dengan aturan berversi. Perhitungan nyata menunggu dataset yang ditinjau independen."
              : isKprTool
                ? "Kalkulator lengkap untuk membandingkan anuitas, flat, dan efektif, mengatur perubahan bunga, mencatat biaya, dan menghitung pembayaran pokok tambahan. Seluruh suku bunga dan biaya adalah input Anda; hasil bukan penawaran bank."
                : isHppTool
                  ? "Hitung biaya pokok satu batch dan per unit. Masukkan biaya langsung, susut bahan, serta overhead dan penyusutan dengan metode alokasi yang terlihat. Semua nilai biaya adalah input Anda."
                    : isPriceMarginTool
                      ? "Bedakan margin dari markup dan hitung harga target atau periksa harga yang sudah ada. Diskon, biaya platform, pajak, dan biaya tetap hanya dihitung jika Anda memasukkannya."
                        : isBepTool
                          ? "Hitung kontribusi per unit, BEP matematis sebagai pecahan eksak, jumlah unit utuh minimum, nilai penjualan, serta laba/rugi di sekitarnya. Seluruh harga dan biaya berasal dari input Anda."
                : tool.description}
          </p>

          {isPayrollTool ? (
            <div class="payroll-module-content">
              <PayrollCalculator client:load />
            </div>
          ) : isKprTool ? (
            <div class="kpr-module-content">
              <KprCalculator client:load />
            </div>
          ) : isHppTool ? (
            <div class="hpp-module-content">
              <HppCalculator client:load />
            </div>
          ) : isPriceMarginTool ? (
            <div class="price-margin-module-content">
              <PriceMarginCalculator client:load />
            </div>
          ) : isBepTool ? (
            <div class="bep-module-content">
              <BreakEvenCalculator client:load />
            </div>
          ) : (
            <div class="module-status-panel" role="status">
              <span class="module-status-icon" aria-hidden="true">i</span>
              <div>
                <h2>Kalkulator belum tersedia</h2>
                <p>
                  Halaman ini belum menjalankan perhitungan. Kalkulator hanya akan
                  diaktifkan setelah rumus, sumber, masa berlaku, pembulatan, dan
                  hasil uji diverifikasi. Tidak ada hasil contoh yang ditampilkan
                  sebagai hasil nyata.
                </p>
              </div>
            </div>
          )}

          {!isCalculatorTool && (
            <div class="module-detail-actions">
              <a class="button button-primary" href="/#modul">
                Kembali ke katalog <span aria-hidden="true">→</span>
              </a>
            </div>
          )}

          <div class="module-trust-points">
            <p><span aria-hidden="true">✓</span> Hasil harus dapat ditelusuri ke metode dan sumber.</p>
            <p><span aria-hidden="true">✓</span> Data finansial dirancang tetap di perangkat Anda.</p>
            <p><span aria-hidden="true">✓</span> {isKprTool
              ? "Ketersediaan simulasi tidak berarti suku bunga atau biaya telah diverifikasi oleh bank."
              : isHppTool
                ? "Metode alokasi mengikuti input Anda; hasil belum memasukkan biaya yang tidak dicatat."
                : isPriceMarginTool
                  ? "Diskon dan biaya dihitung pada dasar yang dinyatakan; tarif pajak atau platform tidak diverifikasi."
                  : isBepTool
                    ? "BEP memakai asumsi biaya dan harga dari Anda; tidak ada tarif resmi atau biaya tersembunyi."
                : "Status ketersediaan tidak berarti kalkulator sudah lulus."}</p>
          </div>
        </section>
      </main>
      <footer class="site-footer">
        <a class="footer-brand" href="/">JOBEN<span>APP</span></a>
        <p>
          {isPayrollTool
            ? "Modul Fase 1.1 · engine tersedia, dataset aturan menunggu tinjauan."
            : isKprTool
              ? "Modul Fase 1.3 · simulasi memakai asumsi pengguna, bukan kutipan bank."
              : isHppTool
                ? "Modul Fase 1.4 · kalkulasi lokal dengan alokasi biaya yang dinyatakan."
                : isPriceMarginTool
                  ? "Modul Fase 1.5 · margin, markup, dan tarif berdasarkan input pengguna."
                  : isBepTool
                    ? "Modul Fase 1.6 · BEP matematis dan unit utuh dengan input pengguna; review independen masih diperlukan."
              : `Modul Fase ${tool.phase} · status implementasi belum tersedia.`}
        </p>
        <a class="footer-privacy-link" href="/lapor-iklan">Laporkan iklan tidak pantas</a>
        <ConsentManager client:load />
      </footer>
    </div>
  </body>
</html>
