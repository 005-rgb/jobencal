---
import "../styles/global.css";
import ConsentManager from "../components/ConsentManager";
import { tools } from "../data/tools";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="JOBENAPP menyiapkan 12 alat hitung Indonesia dengan metode, sumber, dan masa berlaku yang jelas."
    />
    <meta name="theme-color" content="#f4f6fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>JOBENAPP — Alat Hitung Indonesia</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="JOBENAPP, halaman utama">
          <span class="brand-mark" aria-hidden="true">J</span>
          <span>JOBEN<span class="brand-accent">APP</span></span>
        </a>
        <nav class="main-nav" aria-label="Navigasi utama">
          <a href="#modul">Modul</a>
          <a href="#prinsip">Cara kerja</a>
          <a href="#tentang">Tentang</a>
        </nav>
        <a class="header-cta" href="#modul">Lihat modul <span aria-hidden="true">↗</span></a>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="status-pill">
              <span class="status-dot" aria-hidden="true"></span>
              Fase 1.0 · mesin presisi aktif
            </div>
            <h1 id="hero-title">
              Kalkulator Pajak &amp; <span>Keuangan Indonesia</span>
            </h1>
            <p class="hero-description">
              Satu tempat untuk alat bantu keuangan dan bisnis dengan metode,
              aturan, dan sumber yang dapat ditelusuri.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="/demo-mesin-hitung">
                Coba mesin hitung <span aria-hidden="true">→</span>
              </a>
              <a class="button button-secondary" href="#prinsip">Prinsip akurasi</a>
            </div>
            <p class="hero-note">
              Demo ini menguji mesin umum; kalkulator bertarif menunggu sumber dan verifikasi masing-masing.
            </p>
          </div>

          <div class="hero-visual" aria-label="Alur alat hitung JOBENAPP">
            <div class="visual-topline">
              <span>ALUR PERHITUNGAN</span>
              <span class="visual-indicator"><i></i> Terstruktur</span>
            </div>
            <div class="flow-diagram" aria-hidden="true">
              <div class="flow-node node-input">
                <span class="node-icon">
                  <svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h5M8 16h3" /></svg>
                </span>
                <span>Input</span>
              </div>
              <div class="flow-node node-rule">
                <span class="node-icon">
                  <svg viewBox="0 0 24 24"><path d="M12 3 20 7v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7l8-4Zm-3 9 2 2 4-4" /></svg>
                </span>
                <span>Aturan</span>
              </div>
              <div class="flow-node node-method">
                <span class="node-icon">
                  <svg viewBox="0 0 24 24"><path d="M6 4h12M6 9h12M6 14h7M6 19h12M16 13l2 2 3-4" /></svg>
                </span>
                <span>Metode</span>
              </div>
              <div class="flow-node node-result">
                <span class="node-icon">
                  <svg viewBox="0 0 24 24"><path d="M5 19V9m7 10V5m7 14v-7M3 19h18" /></svg>
                </span>
                <span>Hasil</span>
              </div>
              <svg class="flow-lines" viewBox="0 0 430 170" fill="none">
                <path d="M92 84h73M192 84h55M275 84h63" />
                <circle cx="165" cy="84" r="3" />
                <circle cx="247" cy="84" r="3" />
                <circle cx="338" cy="84" r="3" />
              </svg>
            </div>
            <div class="visual-footer">
              <span><b>01</b> Masukkan data</span>
              <span><b>02</b> Periksa metode</span>
              <span><b>03</b> Tinjau hasil</span>
            </div>
            <div class="visual-decoration decoration-one"></div>
            <div class="visual-decoration decoration-two"></div>
          </div>
        </section>

        <section class="module-section" id="modul" aria-labelledby="module-title">
          <div class="section-heading">
            <div>
              <p class="section-kicker">KATALOG ALAT</p>
              <h2 id="module-title">Pilih modul yang Anda butuhkan</h2>
              <p class="section-description">
                Setiap modul memiliki halaman tersendiri. Modul baru aktif setelah perhitungan dan sumbernya diverifikasi.
              </p>
            </div>
            <span class="module-count">12 <span>rencana alat</span></span>
          </div>

          <div class="tool-grid">
            {tools.map((tool) => (
              <a
                class={`tool-card tone-${tool.tone}`}
                href={`/iklan?tujuan=${encodeURIComponent(`/modul/${tool.slug}`)}`}
                aria-label={`Buka modul ${tool.name}`}
              >
                <div class="tool-card-top">
                  <span class="tool-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d={tool.icon} /></svg>
                  </span>
                  <span class="tool-category">{tool.category}</span>
                  <span class="tool-status">
                    {tool.slug === "simulasi-kpr"
                      ? "Simulasi asumsi aktif"
                      : "Belum tersedia"}
                  </span>
                </div>
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                <div class="tool-card-foot">
                  <span class="foot-dot" aria-hidden="true"></span>
                  <span>
                    {tool.slug === "simulasi-kpr" ? "Buka simulasi lokal" : "Pelajari status modul"}
                    <span aria-hidden="true"> →</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="principles-section" id="prinsip" aria-labelledby="principles-title">
          <div class="principles-heading">
            <p class="section-kicker">DIBANGUN UNTUK DIPERCAYA</p>
            <h2 id="principles-title">Angka jelas. Dasarnya juga.</h2>
            <p>Setiap alat mengikuti prinsip produk yang sama sebelum dinyatakan siap digunakan.</p>
          </div>
          <div class="principle-list">
            <article class="principle-item">
              <span class="principle-number">01</span>
              <div>
                <h3>Metode transparan</h3>
                <p>Langkah hitung, asumsi, dan pembulatan dijelaskan.</p>
              </div>
            </article>
            <article class="principle-item">
              <span class="principle-number">02</span>
              <div>
                <h3>Sumber bertanggal</h3>
                <p>Aturan dan data harus mencantumkan sumber serta masa berlaku.</p>
              </div>
            </article>
            <article class="principle-item">
              <span class="principle-number">03</span>
              <div>
                <h3>Privasi sejak awal</h3>
                <p>Data hitungan dirancang tetap di browser kecuali Anda memilih menyimpannya.</p>
              </div>
            </article>
          </div>
        </section>

        <section class="closing-banner" id="tentang" aria-labelledby="closing-title">
          <div>
            <p class="closing-kicker">JOBENAPP · ALAT HITUNG INDONESIA</p>
            <h2 id="closing-title">Mesin hitung kini siap diuji. Aturan tetap harus terverifikasi.</h2>
            <p>Demo mesin hitung tersedia terpisah; 12 alat resmi menunggu implementasi dan pemeriksaan masing-masing.</p>
          </div>
          <a href="/demo-mesin-hitung" class="closing-link">Coba demo mesin <span aria-hidden="true">→</span></a>
          <div class="banner-orb banner-orb-one"></div>
          <div class="banner-orb banner-orb-two"></div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href="/">JOBEN<span>APP</span></a>
        <p>© 2026 JOBENAPP · Platform alat bantu keuangan dan bisnis Indonesia.</p>
        <span class="footer-note">Core system aktif · 12 alat menunggu verifikasi</span>
        <a class="footer-privacy-link" href="/lapor-iklan">Laporkan iklan tidak pantas</a>
        <ConsentManager client:load />
      </footer>
    </div>
  </body>
</html>
