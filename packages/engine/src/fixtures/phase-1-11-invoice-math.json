{
  "phase": "1.11",
  "methodKey": "documents.invoice-receipt",
  "methodVersion": "1.11.0",
  "checkedOn": "2026-10-27",
  "oracle": "Expected values are hand-calculated with exact integer ratios and the stated per-line half-away-from-zero rule; they are not generated by the production engine.",
  "reviewStatus": "pending_independent_human_review",
  "reviewer": null,
  "cases": [
    {
      "id": "single-whole-unit",
      "scenario": "Satu item, kuantitas bulat, tanpa diskon",
      "documentType": "invoice",
      "lines": [{ "description": "Barang", "quantityThousandths": "1000", "unit": "pcs", "unitPriceRupiah": "12500" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "12500", "totalRupiah": "12500" }
    },
    {
      "id": "multiple-items",
      "scenario": "Dua item dijumlahkan sesudah pembulatan per baris",
      "documentType": "invoice",
      "lines": [
        { "description": "Barang A", "quantityThousandths": "2000", "unit": "pcs", "unitPriceRupiah": "1500" },
        { "description": "Barang B", "quantityThousandths": "3000", "unit": "pcs", "unitPriceRupiah": "750" }
      ],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "5250", "totalRupiah": "5250" }
    },
    {
      "id": "fractional-quantity-exact",
      "scenario": "Kuantitas pecahan menghasilkan Rupiah bulat eksak",
      "documentType": "invoice",
      "lines": [{ "description": "Kain", "quantityThousandths": "1250", "unit": "meter", "unitPriceRupiah": "8000" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "10000", "totalRupiah": "10000" }
    },
    {
      "id": "half-rupiah-away",
      "scenario": "Nilai tepat setengah dibulatkan menjauhi nol",
      "documentType": "invoice",
      "lines": [{ "description": "Pembulatan setengah", "quantityThousandths": "1001", "unit": "unit", "unitPriceRupiah": "500" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "501", "totalRupiah": "501" }
    },
    {
      "id": "fraction-below-half",
      "scenario": "Sisa pecahan di bawah setengah dibulatkan ke bawah",
      "documentType": "invoice",
      "lines": [{ "description": "Pembulatan bawah", "quantityThousandths": "1001", "unit": "unit", "unitPriceRupiah": "499" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "499", "totalRupiah": "499" }
    },
    {
      "id": "round-each-line",
      "scenario": "Dua baris setengah Rupiah dibulatkan masing-masing, bukan setelah agregasi",
      "documentType": "invoice",
      "lines": [
        { "description": "Setengah satu", "quantityThousandths": "1", "unit": "unit", "unitPriceRupiah": "500" },
        { "description": "Setengah dua", "quantityThousandths": "1", "unit": "unit", "unitPriceRupiah": "500" }
      ],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "2", "totalRupiah": "2" }
    },
    {
      "id": "zero-price",
      "scenario": "Harga nol valid dan total nol ditampilkan sebagai nol",
      "documentType": "invoice",
      "lines": [{ "description": "Sampel gratis", "quantityThousandths": "1000", "unit": "pcs", "unitPriceRupiah": "0" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "0", "totalRupiah": "0" }
    },
    {
      "id": "discount-exact",
      "scenario": "Diskon sama dengan subtotal menghasilkan total nol",
      "documentType": "invoice",
      "lines": [{ "description": "Barang diskon", "quantityThousandths": "2000", "unit": "pcs", "unitPriceRupiah": "5000" }],
      "discountRupiah": "10000",
      "expected": { "subtotalRupiah": "10000", "totalRupiah": "0" }
    },
    {
      "id": "receipt-no-tax",
      "scenario": "Kwitansi memakai perhitungan sama dan tidak menambahkan pajak tanpa konfigurasi",
      "documentType": "receipt",
      "lines": [{ "description": "Jasa", "quantityThousandths": "1500", "unit": "jam", "unitPriceRupiah": "20000" }],
      "discountRupiah": "5000",
      "expected": { "subtotalRupiah": "30000", "totalRupiah": "25000" }
    },
    {
      "id": "maximum-rupiah",
      "scenario": "Nominal maksimum 18 digit tetap eksak",
      "documentType": "invoice",
      "lines": [{ "description": "Nominal batas", "quantityThousandths": "1000", "unit": "unit", "unitPriceRupiah": "999999999999999999" }],
      "discountRupiah": "0",
      "expected": { "subtotalRupiah": "999999999999999999", "totalRupiah": "999999999999999999" }
    },
    {
      "id": "discount-over-subtotal",
      "scenario": "Diskon melebihi subtotal ditolak",
      "documentType": "invoice",
      "lines": [{ "description": "Barang", "quantityThousandths": "1000", "unit": "pcs", "unitPriceRupiah": "10000" }],
      "discountRupiah": "10001",
      "expectedError": "discount_exceeds_subtotal"
    },
    {
      "id": "invalid-date",
      "scenario": "Tanggal kalender yang tidak ada ditolak",
      "documentType": "receipt",
      "issueDate": "2026-02-30",
      "lines": [{ "description": "Jasa", "quantityThousandths": "1000", "unit": "jam", "unitPriceRupiah": "10000" }],
      "discountRupiah": "0",
      "expectedError": "invalid_issue_date"
    }
  ],
  "validationCases": [
    {
      "id": "missing-document-number-and-recipient",
      "scenario": "Nomor dan identitas penerima wajib diisi",
      "expectedErrors": ["invalid_document_number", "invalid_identity"]
    },
    {
      "id": "missing-item-description",
      "scenario": "Nama item wajib diisi",
      "expectedError": "invalid_line_description"
    },
    {
      "id": "zero-quantity",
      "scenario": "Kuantitas nol ditolak",
      "expectedError": "invalid_quantity"
    },
    {
      "id": "empty-lines",
      "scenario": "Dokumen tanpa baris item ditolak",
      "expectedError": "invalid_lines"
    }
  ]
